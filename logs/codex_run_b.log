+              <Text style={[styles.horseMeta, { color: colors.textMuted }]}>{row.weight} · 마체 {row.body}</Text>
+            </View>
+          </View>
+        ))}
+      </View>
+    </LensCard>
+  );
+}
+
+function formatPickLabel(code: string, label: string) {
