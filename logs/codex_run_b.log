+  const direction = metric.zscore >= 0 ? '높습니다' : '낮습니다';
+  const frames = [
+    `${participant.name}의 가장 특이한 지표는 ${metric.label} ${metric.value}로, 경주 평균보다 ${zText} ${direction}.`,
