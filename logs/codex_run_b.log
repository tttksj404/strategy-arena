    marketUsed: false,
    marketSource: 'unavailable',
    marketRisk: {
      level: 'caution',
      title: '원자료 연결 대기',
      message
    },
    confidence: {
      label: '대기',
      top1: 0,
      trifecta: 0,
      sample: 0
    },
    picks: [],
