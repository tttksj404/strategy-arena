  try {
    const parsed = new URL(trimmed);
    const local = parsed.hostname === 'localhost' || parsed.hostname === '127.0.0.1';
    if (parsed.protocol === 'https:' || (parsed.protocol === 'http:' && local)) {
      return parsed.toString().replace(/\/$/, '');
    }
  } catch {
