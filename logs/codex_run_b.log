+function rosterLabel(verification: RosterVerification) {
+  if (verification.state === 'verified') return '공식 출주표 대조 완료';
+  if (verification.state === 'mismatch') return '공식 출주표 불일치';
+  return '공식 대조 미완료 — 참고용';
+}
+
+function RosterVerificationBadge({ mode, verification }: { mode: ThemeMode; verification: RosterVerification }) {
+  const level = verification.state === 'verified' ? 'verified' : verification.state === 'mismatch' ? 'blocked' : 'caution';
+  return <StatusPill mode={mode} level={level} label={rosterLabel(verification)} />;
+}
+
+function RosterMismatchBlock({ mode, verification }: { mode: ThemeMode; verification: RosterVerification }) {
+  const colors = palette(mode);
+  return (
+    <LensCard mode={mode} variant="blocked">
+      <View style={styles.blockHeader}>
+        <Ionicons
+          accessibilityElementsHidden
+          accessible={false}
+          importantForAccessibility="no-hide-descendants"
+          name="alert-circle-outline"
+          size={24}
+          color={colors.accentRose}
+        />
+        <Text style={[styles.blockTitle, { color: colors.textPrimary }]}>공식 출주표와 달라 예측을 중단했습니다</Text>
+      </View>
+      <Text style={[styles.blockCopy, { color: colors.textSecondary }]}>
+        {verification.message ?? '서버가 받은 출전 명단이 공식 출주표와 일치하지 않아 모델 결과를 숨깁니다.'}
+      </Text>
+    </LensCard>
+  );
+}
+
+function metricValue(items: ParticipantMetric[], label: string) {
+  return items.find((item) => item.label === label)?.value ?? '-';
+}
+
+function metricNumber(items: ParticipantMetric[], label: string) {
+  const match = metricValue(items, label).match(/-?\d+(?:\.\d+)?/);
+  return match ? Number(match[0]) : null;
+}
+
+function tacticPercent(participant: RaceParticipant, label: string) {
+  return metricNumber(participant.tactics, label) ?? 0;
+}
+
+function KeirinDevelopmentCard({ decision, mode }: { decision: RaceDecision; mode: ThemeMode }) {
