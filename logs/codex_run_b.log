+        mean = sum(values) / len(values)
+        variance = sum((value - mean) ** 2 for value in values) / len(values)
+        if variance <= 0:
+            continue
+        zscore = (current - mean) / math.sqrt(variance)
+        magnitude = abs(zscore)
+        if best is None or magnitude > best["magnitude"]:
