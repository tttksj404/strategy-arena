+def _store_platform(value: str) -> str:
+    normalized = str(value or "").strip().lower()
+    if normalized in {"ios", "apple", "app_store"}:
+        return "ios"
+    if normalized in {"android", "google", "google_play", "play"}:
+        return "android"
+    return normalized[:32]
