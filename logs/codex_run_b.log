  const localPreview = (hostname === 'localhost' || hostname === '127.0.0.1') && port === '4173';
  if (!localPreview && (hostname === 'localhost' || hostname === '127.0.0.1')) return '';
  if (protocol !== 'https:' && protocol !== 'http:') return '';
