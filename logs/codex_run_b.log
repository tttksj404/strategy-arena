+}
+
+function RosterVerificationBadge({ mode, verification }: { mode: ThemeMode; verification: RosterVerification }) {
+  const level = verification.state === 'verified' ? 'verified' : verification.state === 'mismatch' ? 'blocked' : 'caution';
+  return <StatusPill mode={mode} level={level} label={rosterLabel(verification)} />;
+}
+
+function RosterMismatchBlock({ mode, verification }: { mode: ThemeMode; verification: RosterVerification }) {
+  const colors = palette(mode);
+  return (
