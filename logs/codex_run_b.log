  '고확신 필터와 마감 직전 갱신',
  '과거 유사 경주와 복기 리포트',
  '모델 후보의 검증 로그'
];

const lockedFeatures = [
  '고확신 후보만 모아보기',
  '마감 직전 배당 변화 알림',
