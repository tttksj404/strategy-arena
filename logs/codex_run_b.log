 import type { ParticipantMetric, RaceParticipant, Sport } from '../types/race';
 
 type MetricGroup = Pick<RaceParticipant, 'form' | 'profile' | 'tactics'>;
+type UnusualMetric = {
+  readonly label: string;
+  readonly value: string;
+  readonly zscore: number;
