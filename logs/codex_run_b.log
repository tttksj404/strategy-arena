# (sport, meet) -> (days_list, fetched_ts, status) 모듈 전역 캐시.
# status: "ok"(성공, 1h TTL) / "empty"(빈 결과, 5분 TTL) / "fail"(에러, 60s 음수캐시).
_RECENT_CACHE = {}
_RECENT_TTL = 3600        # 성공 시 1시간
_RECENT_EMPTY_TTL = 300   # 빈 결과 5분
_RECENT_FAIL_TTL = 60     # 실패 60초 (음수 캐싱 → 반복 타임아웃 방지)
