    main {{ max-width: 760px; margin: 0 auto; padding: 48px 20px 64px; line-height: 1.65; }}
    h1 {{ font-size: 2rem; margin: 0 0 8px; }}
    h2 {{ font-size: 1.1rem; margin: 28px 0 8px; }}
    p {{ margin: 0 0 12px; }}
    .meta {{ color: #5f6472; margin-bottom: 28px; }}
    a {{ color: #005f73; }}
