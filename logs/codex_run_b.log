+                ON CONFLICT (user_id)
+                DO UPDATE SET platform = EXCLUDED.platform, product_id = EXCLUDED.product_id,
+                    status = EXCLUDED.status, expires_at = EXCLUDED.expires_at, updated_at = EXCLUDED.updated_at""",
