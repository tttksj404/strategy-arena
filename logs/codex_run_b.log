+    `${participant.name}${topicParticle(participant.name)} ${metric.label} ${metric.value}에서 가장 두드러져 평균 대비 ${zText} 차이를 보입니다.`
+  ] as const;
+  return frames[frameIndex(participant, raceDate)] ?? frames[0];
+}
