+            best = {
+                "label": label,
+                "value": value_text,
+                "zscore": zscore,
+                "magnitude": magnitude,
+            }
+    if best is not None:
+        return best
+    return {
+        "label": "모델 1착",
+        "value": _explain_pct(row.get("pwin")),
+        "zscore": 0.0,
