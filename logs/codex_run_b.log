+  if (source === 'settled') return '확정 결과 자료';
+  const ageText = oddsAgeSec === null ? '갱신 시각 확인 중' : `${oddsAgeSec}초 전 갱신`;
+  return `${formatKstTime(updatedAt)} KST · ${ageText}`;
+}
