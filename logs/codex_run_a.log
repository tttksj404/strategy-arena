    def test_live_decision_records_device_prediction_and_view_event(self):
        base = {"kind": "ok", "rows": [{"bno": 4, "name": "A", "pwin": 0.6, "pplc": 0.8}]}
        decision = {
            "ok": True,
            "status": "odds_live",
