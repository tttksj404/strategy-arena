+            if not m:
+                continue
+            try:
+                bno = int(m.group(1))
+                rank = int(str(cells[1]).strip())
+            except ValueError:
+                continue
+            racers.append({"bno": bno, "name": m.group(2).strip(), "rank": rank})
+            if rank in {1, 2, 3}:
+                finish_by_rank[rank] = bno
+        elif in_payout_table and len(cells) >= 3:
