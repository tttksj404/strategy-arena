_MODEL = None
_MODEL_ERR = None


def load_model():
    """model_final.joblib 지연 로드. 실패 시 (None, 에러문자열)."""
    global _MODEL, _MODEL_ERR
    if _MODEL is not None or _MODEL_ERR is not None:
        return _MODEL, _MODEL_ERR
    try:
        import joblib
        _MODEL = joblib.load(MODEL_PATH)
    except Exception as e:  # noqa: BLE001
