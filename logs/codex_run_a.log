DEFAULT_SUMMARY = ROOT / "data" / "prediction_feedback_summary.json"

DEFAULT_DELTA_LIMIT = 0.08
DEFAULT_MIN_OOS_RACES = 30
DEFAULT_MIN_GRADE_POLICY_RECOMMENDATIONS = 3

