+def _allowed_cors_origin():
+    configured = {
+        item.strip()
+        for item in (os.environ.get("RACELENS_ALLOWED_ORIGINS") or "").split(",")
+        if item.strip()
+    }
+    if not configured:
+        return "*"
+    origin = request.headers.get("Origin")
+    if origin in configured:
+        return origin
+    return None
