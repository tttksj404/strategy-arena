 # ═══════════════════════ 실시간 판단 (live-decision) ═══════════════════════
+ROSTER_MISMATCH_MESSAGE = "공식 출주표와 일치하지 않아 예측을 중단했습니다"
+_ROSTER_STATES = {"verified", "unverified", "mismatch"}
+
