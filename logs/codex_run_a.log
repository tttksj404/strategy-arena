+            in_result_table = True
+            in_payout_table = False
+            continue
+        if cells[:3] == ["승식", "승자", "평균확정배당률"]:
+            in_result_table = False
+            in_payout_table = True
+            continue
+        if in_result_table and len(cells) >= 2:
