def mach(s):
    """①~⑨ 또는 (3)/3 형태에서 마번(back_no) 정수 추출."""
    if not s:
        return None
    for ch in str(s):
        if ch in CIRCLE:
            return CIRCLE[ch]
    m = re.match(r"\s*\(?(\d+)", str(s))
    return int(m.group(1)) if m else None


def norm_ymd(s):
    """'2026-06-20' / '20260620' / '2026.06.20' -> '2026.06.20'."""
    d = re.sub(r"\D", "", str(s or ""))
    if len(d) >= 8:
        return f"{d[0:4]}.{d[4:6]}.{d[6:8]}"
    return str(s or "").strip()


