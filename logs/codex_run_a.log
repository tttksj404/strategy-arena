+    placeholder = "%s" if config.storage == "postgresql" else "?"
+    row = conn.execute(f"SELECT user_id FROM {devices} WHERE id = {placeholder}", (device_id,)).fetchone()
+    if not row:
+        return None
+    return str(row["user_id"] if not isinstance(row, tuple) else row[0])
