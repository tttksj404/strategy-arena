+def _safe_error_payload(error: Exception, status_code: int):
+    if not _debug_errors_enabled():
+        return {"error": "internal_server_error", "status": status_code}
+    import traceback
+    return {
+        "error": type(error).__name__,
+        "detail": str(error),
