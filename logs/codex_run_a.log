    for name in ("DATAGOKR_SERVICE_KEY", "datagokr", "DATAGOKR", "DATA_GO_KR_KEY", "SERVICE_KEY"):
        v = os.environ.get(name)
        if v and v.strip():
            return v.strip()
    return None


def _has_key():
    return bool(_get_key())


