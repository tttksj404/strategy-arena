+    row = conn.execute(
+        f"""SELECT user_id FROM {table}
+            WHERE ip_address = {placeholder} AND usage_date = {placeholder}
+            ORDER BY created_at DESC LIMIT 1""",
+        (ip_address, _usage_date()),
